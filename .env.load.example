# Used only with `docker compose -p gear-drop-load --env-file .env.load`.
# It creates separate Docker volumes and must never point to production.
ENV_FILE=.env.load

DJANGO_SECRET_KEY=replace-with-a-local-load-test-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8081
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

DB_ENGINE=django.db.backends.postgresql
DB_USER=promocode_load
DB_PASSWORD=promocode_load_only
DB_NAME=promocode_load
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60
POSTGRES_USER=promocode_load
POSTGRES_PASSWORD=promocode_load_only
POSTGRES_DB=promocode_load

REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/2
CACHE_URL=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@load.test
FRONTEND_URL=http://127.0.0.1:8081
XLSX_MAX_UPLOAD_SIZE=20971520
LOAD_TEST_ALLOWED=True

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
APP_BIND=127.0.0.1
APP_PORT=8081
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
